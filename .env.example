# PostgreSQL connection string from your Neon project (Dashboard → Connection Details).
DATABASE_URL="postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js: random secret used to sign sessions/cookies. Generate with `npx auth secret`.
AUTH_SECRET=""

# Google OAuth client, from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that get promoted to ADMIN the first time they sign in.
ADMIN_EMAILS="you@example.com"

# Optional: enables POST /api/test-login for Playwright's authenticated admin
# tests to sign in without real Google OAuth. That route always 404s when
# NODE_ENV=production (i.e. on Vercel) regardless of this var, so it's safe
# to set locally - just never set it in a production environment.
E2E_TEST_LOGIN_SECRET=""
