// Prisma schema for Set Club
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models (PrismaAdapter) -----------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  player             Player?
  createdTournaments Tournament[] @relation("TournamentCreatedBy")
  newsPosts          NewsPost[]   @relation("NewsPostAuthor")
  auditLogs          AuditLog[]
  uploadedPhotos     Photo[]
  adminDomains       UserAdminDomain[]

  @@map("users")
}

// SUPERADMIN: full access everywhere, always (see src/lib/permissions.ts).
// ADMIN: scoped admin - only meaningful together with UserAdminDomain rows
// (docs/ADMIN_DOMAINS.md) picking which of Кава/Теніс/Падел they manage; an
// ADMIN with zero domain rows can do nothing yet. MEMBER: no admin access.
enum Role {
  SUPERADMIN
  ADMIN
  MEMBER
}

// Scoped admin access for MEMBER users (Role.ADMIN is always a superadmin
// with full access everywhere, regardless of rows here - see
// src/lib/permissions.ts and docs/ADMIN_DOMAINS.md). A user can hold any
// combination of domains at once (e.g. TENNIS + COFFEE).
model UserAdminDomain {
  id     String      @id @default(cuid())
  userId String
  domain AdminDomain

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@map("user_admin_domains")
}

enum AdminDomain {
  TENNIS
  COFFEE
  PADEL
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// Optional cover photo's R2 object key (not a full URL - same convention as Photo.key), uploaded the same browser-directly-to-R2 way (see docs/PHOTOS.md) rather than through this row's own create/update Server Action, which has Next's default 1MB body limit. @unique so one post can never "steal" another post's still-referenced key (R2 keys aren't secret - visible in every public photo URL) - without it, cleanUpOldPhoto's unconditional deleteObject on photoKey change/removal could silently break a different post's cover image.
  photoKey  String?  @unique
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("NewsPostAuthor", fields: [authorId], references: [id])

  @@map("news_posts")
}

// One row per admin mutation (create/update/delete/etc.), for reconstructing
// "who did what, when" when multiple admins manage the same data. actorLabel
// snapshots the admin's name/email at write time so the log stays readable
// even if that user is later removed (actorId -> SetNull, not cascaded away).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorLabel String
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

// The Coffee section's menu (COFFEE-domain admin, see docs/ADMIN_DOMAINS.md).
// A MenuSection is a named group an admin can create freely (not a fixed
// enum) - "Кава"/"Чай"/"Матча"/"Інше" render as a compact LIST of
// name+price rows, while thematic collections like "Special Menu"/"Matcha
// Menu" (own title + optional tagline, e.g. "love yourself, drink matcha")
// render as CARDS with photo+description. Same MenuItem shape either way -
// description/photoKey just stay null for LIST-layout rows, since a plain
// price-list entry usually has neither.
enum MenuLayout {
  LIST
  CARDS
}

model MenuSection {
  id        String     @id @default(cuid())
  name      String
  tagline   String?
  layout    MenuLayout @default(LIST)
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items MenuItem[]

  @@map("menu_sections")
}

model MenuItem {
  id          String   @id @default(cuid())
  sectionId   String
  name        String
  /// Whole hryvnias (e.g. 95 for "95 грн") - the menu has never priced anything with kopecks, same reasoning as RatingSnapshot.rating being an Int rather than Decimal.
  price       Int
  description String?
  /// R2 object key, not a full URL (see Photo.key/NewsPost.photoKey for the same convention) - @unique for the same reason as NewsPost.photoKey: keys aren't secret, so without this constraint one item's still-referenced photo could be "stolen" by pasting its key into another item.
  photoKey    String?  @unique
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("menu_items")
}

// --- Club domain models -------------------------------------------------

// A club member/participant. Separate from User so an admin can create
// a placeholder player (name only, no account) for historical results,
// which later auto-links to a User when someone signs in with a matching
// Google email.
model Player {
  id        String   @id @default(cuid())
  name      String
  /// Optional display name shown instead of `name` almost everywhere (see src/lib/player-display.ts) - `name` itself is never edited by this feature, only which one the UI reads.
  nickname  String?
  email     String?  @unique
  userId    String?  @unique
  gender    Gender?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  tournamentEntries TournamentParticipant[]
  matchAppearances  MatchPlayer[]
  ratingSnapshots   RatingSnapshot[]
  groupMemberships  TournamentGroupMember[]
  teamMemberships   TournamentTeamMember[]

  @@map("players")
}

enum Gender {
  MALE
  FEMALE
}

enum TournamentFormat {
  SINGLES
  DOUBLES
  MIXED
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum CourtSurface {
  CLAY
  GRASS
  HARD
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  format      TournamentFormat
  status      TournamentStatus @default(UPCOMING)
  surface     CourtSurface     @default(CLAY)
  startDate   DateTime
  endDate     DateTime
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy         User                    @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  participants      TournamentParticipant[]
  matches           Match[]
  ratingSnapshots   RatingSnapshot[]
  groups            TournamentGroup[]
  matchAdvancements MatchAdvancement[]
  photos            Photo[]
  teams             TournamentTeam[]
  ties              TournamentTie[]

  @@map("tournaments")
}

// A tournament photo stored in Cloudflare R2 (S3-compatible object storage) -
// `key` is the R2 object key, not a full URL, so the public base URL
// (R2_PUBLIC_URL, see src/lib/r2.ts) can change (e.g. r2.dev -> custom
// domain) without touching stored rows. uploadedBy is SetNull rather than
// Cascade so removing a user doesn't delete photos they uploaded - matches
// AuditLog.actor and Player.user.
model Photo {
  id           String   @id @default(cuid())
  tournamentId String
  key          String   @unique
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  uploadedBy User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("photos")
}

// Free-text name for a round-robin group number beyond the built-in 1-6
// (A-F) range - lets an admin add extra groups on the fly (e.g. "Плейофф")
// without touching TournamentParticipant.group's existing numeric
// contract. groupRoundLabel(n)'s letter mapping still covers 1-6; this
// table is only consulted for numbers it doesn't recognize (see
// resolveGroupLabel in src/lib/randomize-pairs.ts).
model TournamentGroup {
  id           String   @id @default(cuid())
  tournamentId String
  number       Int
  name         String
  createdAt    DateTime @default(now())

  tournament Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members    TournamentGroupMember[]

  @@unique([tournamentId, number])
  @@map("tournament_groups")
}

// Many-to-many membership for a TournamentGroup - deliberately separate from
// TournamentParticipant.group (the built-in 1-6/A-F round-robin bucket,
// still exactly one per participant): a custom group is an *additional*
// overlay (e.g. "Плейофф" drawing from several round-robin groups), not a
// replacement, so a player can be a member of any number of these at once
// without touching their built-in group.
model TournamentGroupMember {
  id                String   @id @default(cuid())
  tournamentGroupId String
  playerId          String
  createdAt         DateTime @default(now())

  group  TournamentGroup @relation(fields: [tournamentGroupId], references: [id], onDelete: Cascade)
  player Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentGroupId, playerId])
  @@index([playerId])
  @@map("tournament_group_members")
}

model TournamentParticipant {
  id           String    @id @default(cuid())
  tournamentId String
  playerId     String
  seed         Int?
  /// Admin-assigned round-robin group (1-6) for SINGLES/MIXED/DOUBLES tournaments, independent of `seed` - for DOUBLES a team belongs to a group only when both its players share the same one (see getTournamentStandingsRows).
  group        Int?
  joinedAt     DateTime  @default(now())
  /// Set once (never cleared) when an admin withdraws this participant from the tournament (see withdrawParticipantAction) - null means still active. Excludes them from new randomizer/manual match draws and from groupRankPlayer's bracket-advancement candidates, but leaves them visible in the roster/standings.
  withdrawnAt  DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("tournament_participants")
}

// Optional, opt-in roster unit for MIXED tournaments that use team/tie play
// (see TournamentTie) - a fixed group of 2-4 players an admin forms
// deliberately, unrelated to TournamentGroup/TournamentGroupMember (that's a
// many-to-many round-robin-bracket-labeling overlay a player can belong to
// several of at once; a team is a roster a player belongs to at most one of,
// per tournament - see TournamentTeamMember's unique constraint). Team size
// (2-4) is enforced in src/lib/validation/team.ts, not here - same as the
// existing "max 2 players per match side" constraint, which also lives in
// Zod rather than the schema.
model TournamentTeam {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  createdAt    DateTime @default(now())

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members    TournamentTeamMember[]
  tiesAsA    TournamentTie[]        @relation("TieTeamA")
  tiesAsB    TournamentTie[]        @relation("TieTeamB")

  @@index([tournamentId])
  @@map("tournament_teams")
}

// One player's membership in one TournamentTeam. tournamentId is
// denormalized from TournamentTeam purely so the DB itself can enforce "at
// most one team per player per tournament" via the unique constraint below -
// the same [tournamentId, playerId] shape TournamentParticipant already uses
// for its own one-row-per-player guarantee.
model TournamentTeamMember {
  id               String   @id @default(cuid())
  tournamentTeamId String
  tournamentId     String
  playerId         String
  createdAt        DateTime @default(now())

  team   TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  player Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([tournamentTeamId])
  @@index([playerId])
  @@map("tournament_team_members")
}

// A Davis-Cup-style tie between two teams - the team that wins more of its
// rubbers (Match rows with tieId pointing here, see Match.tie) wins the tie.
// A tie carries no score of its own; src/lib/tournament-ties.ts derives the
// winner purely by counting each rubber's completed result. teamAId/teamBId
// deliberately have no onDelete: Cascade - deleting a team still referenced
// by a tie fails on this FK and is surfaced as a clear error (see
// deleteTeamAction), rather than silently orphaning the tie.
model TournamentTie {
  id           String   @id @default(cuid())
  tournamentId String
  teamAId      String
  teamBId      String
  // Optional free-text label (e.g. "Тур 1") - lets the same two teams meet
  // more than once without the ties being indistinguishable, same spirit as
  // Match.round being free text rather than a fixed enum.
  label        String?
  createdAt    DateTime @default(now())

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA      TournamentTeam @relation("TieTeamA", fields: [teamAId], references: [id])
  teamB      TournamentTeam @relation("TieTeamB", fields: [teamBId], references: [id])
  rubbers    Match[]

  @@index([tournamentId])
  @@index([teamAId])
  @@index([teamBId])
  @@map("tournament_ties")
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MatchSide {
  A
  B
}

model Match {
  id            String      @id @default(cuid())
  tournamentId  String
  // Free text (curated playoff labels, randomizer group labels, or fully
  // custom admin text) - not a Prisma enum on purpose, see playoff-rounds.ts.
  // A migration-only partial unique index (not representable in this DSL)
  // additionally guarantees at most one match per tournament for each of the
  // six placement-deciding rounds - see the
  // 20260804121402_unique_placement_round_per_tournament migration.
  round         String?
  matchType     MatchType
  scheduledDate DateTime?
  status        MatchStatus @default(SCHEDULED)
  winnerSide    MatchSide?
  // When the score was saved and the match became COMPLETED - shown next to
  // the match date, not to be confused with scheduledDate (when it was meant
  // to be played) or updatedAt (bumped by unrelated edits like round/players).
  completedAt   DateTime?
  // Player conceded mid-match (injury etc.) - when true, sets/scores don't
  // have to form a complete, legal result (e.g. a partial final set).
  retired       Boolean     @default(false)
  // Technical loss auto-assigned by withdrawParticipantAction when a player
  // withdraws from the tournament with this match still SCHEDULED - distinct
  // from `retired` (which means "conceded partway through an actually-played
  // match"). Always COMPLETED with an empty `sets` and winnerSide set to the
  // opponent; excluded from the withdrawn side's personal W/L (see
  // player-stats.ts/tournament-standings.ts) and from rating entirely (see
  // fetchRatingMatchRows) - the opponent still gets a normal standings win.
  walkover      Boolean     @default(false)
  // Set only for a rubber created inside a team tie (see createRubberAction
  // in src/lib/actions/ties.ts) - null for every match created through the
  // existing flow, which is the overwhelming majority and must stay
  // unaffected by this column's mere existence. SetNull rather than Cascade:
  // a rubber is a real, individually rated match, so deleting the tie it
  // belongs to should only un-tag it, never silently destroy its score.
  tieId         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tie        TournamentTie? @relation(fields: [tieId], references: [id], onDelete: SetNull)
  players    MatchPlayer[]
  sets       MatchSet[]

  advancementsAsTarget MatchAdvancement[] @relation("MatchAdvancementTarget")
  advancementsAsSource MatchAdvancement[] @relation("MatchAdvancementSource")

  @@index([tournamentId])
  /// Nearly every club-wide (not tournament-scoped) read - getRecentCompletedMatches, player-stats.ts, head-to-head.ts, activity-trend.ts, rating/ratings-data.ts - filters `status: "COMPLETED", winnerSide: { not: null }` with no tournamentId, so tournamentId's own index above doesn't help them; this turns that into an index scan over just the COMPLETED subset instead of a full table scan.
  @@index([status])
  @@index([tieId])
  @@map("matches")
}

enum AdvancementSource {
  GROUP_RANK
  MATCH_RESULT
}

enum AdvancementOutcome {
  WINNER
  LOSER
}

// Declares that MatchPlayer(matchId, side) should be auto-filled once its
// source is decided, instead of being set by an admin - the wiring for a
// bracket-shaped randomizer (currently only "4 групи по 3 + плей-офф" for a
// 12-player SINGLES tournament, see src/lib/groups12-playoff-bracket.ts).
// Resolved by src/lib/bracket-advancement.ts, which runs inside
// saveScoreAction after every score save, guarded by a count() against this
// table - a tournament with zero rows here (every tournament not created via
// that randomizer) makes the hook a no-op.
model MatchAdvancement {
  id           String            @id @default(cuid())
  tournamentId String
  matchId      String
  side         MatchSide
  source       AdvancementSource

  // GROUP_RANK case: fill from rank `sourceRank` (1-3) of built-in group
  // `sourceGroup` (TournamentParticipant.group) once ALL of that group's
  // round-robin matches are COMPLETED.
  sourceGroup Int?
  sourceRank  Int?

  // MATCH_RESULT case: fill from the winner/loser of `sourceMatchId` once
  // that match is COMPLETED.
  sourceMatchId String?
  outcome       AdvancementOutcome?

  createdAt DateTime @default(now())

  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match       Match      @relation("MatchAdvancementTarget", fields: [matchId], references: [id], onDelete: Cascade)
  sourceMatch Match?     @relation("MatchAdvancementSource", fields: [sourceMatchId], references: [id], onDelete: Cascade)

  @@unique([matchId, side])
  @@index([tournamentId])
  @@index([sourceMatchId])
  @@map("match_advancements")
}

model MatchPlayer {
  id       String    @id @default(cuid())
  matchId  String
  side     MatchSide
  playerId String

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, side, playerId])
  @@index([playerId])
  @@map("match_players")
}

model MatchSet {
  id                  String @id @default(cuid())
  matchId             String
  setNumber           Int
  sideAGames          Int
  sideBGames          Int
  // Only set when this set finished 7-6/6-7: the full tiebreak point score
  // for each side (e.g. 7-6, tiebreak 7-5 -> tiebreakSideAPoints=7,
  // tiebreakSideBPoints=5), shown for both sides rather than just the loser.
  tiebreakSideAPoints Int?
  tiebreakSideBPoints Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@map("match_sets")
}

// A derived/materialized snapshot of a player's Glicko-2/OpenSkill rating as
// of one tournament, for the "rating over time" chart. NOT a source of truth:
// ratings are always recomputed from raw Match/MatchSet rows (see
// src/lib/rating/engine.ts and docs/RATING.md), and this table is fully
// wiped and rebuilt from that computation after every match-affecting
// mutation (src/lib/rating/snapshot.ts) - same "delete and recreate wholesale
// rather than patch" approach saveScoreAction already uses for MatchSet.
model RatingSnapshot {
  id           String    @id @default(cuid())
  playerId     String
  matchType    MatchType
  tournamentId String
  asOfDate     DateTime
  /// Already display-ready (Math.round'd conservative rating), same number shown on /rating and the player profile - not the engine's raw internal units.
  rating       Int
  spread       Int
  createdAt    DateTime  @default(now())

  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([playerId, matchType, tournamentId])
  @@index([playerId, matchType, asOfDate])
  @@map("rating_snapshots")
}
