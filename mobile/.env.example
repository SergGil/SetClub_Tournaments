# Copy to .env and fill in - see docs/MOBILE_APP.md.

# next dev's LAN IP:port (a phone/emulator can't reach "localhost" on the dev
# machine) - e.g. http://192.168.1.23:3000. Find your LAN IP with `ipconfig`
# (Windows) and confirm `next dev` is bound to 0.0.0.0, not just localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000

# Google OAuth client id (type "iOS" or "Android", NOT "Web") from the same
# Google Cloud project as the web app's AUTH_GOOGLE_ID - see docs/MOBILE_APP.md.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
